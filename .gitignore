# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Environment files & secrets ---
.env
*.env
!example.env
secrets.json
*.pem

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Editors ---
.idea/
*.swp

# --- Generated data ---
# Raw API downloads and processed datasets are reproducible from code,
# so they are not committed. The directory structure is kept via .gitkeep.
data/raw/**
data/processed/**
!data/raw/**/
!data/processed/**/
!data/**/.gitkeep

# --- Trained model artifacts ---
# Model weights, scalers, and feature metadata are build outputs.
artifacts/**
!artifacts/.gitkeep

# NOTE: tests/fixtures/ is intentionally NOT ignored. It holds a small,
# committed sample of real play-by-play so the test suite runs offline
# without requiring anyone to download data first.
