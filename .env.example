# Replay works offline with the authentic committed Phase 6 fixture.
NBA_APP_MODE=replay
NBA_APP_ENV=development
NBA_POLL_INTERVAL_SECONDS=5
NBA_REPLAY_INTERVAL_SECONDS=0.5
NBA_REPLAY_SPEED=4
NBA_APP_HOST=127.0.0.1
NBA_APP_PORT=5000
NBA_APP_DEBUG=false

# Cloud platforms commonly inject these generic names. NBA_APP_HOST and
# NBA_APP_PORT take precedence when both forms are set.
HOST=127.0.0.1
PORT=5000
